# .env.example — key inventory for QuickBrain
# Copy to .env.local and fill in real values. Never commit .env.local.
# All keys listed here are read by the application at runtime (or build time).
# Keys marked [build-time] are read by next build / withSentryConfig only.

# ─── gbrain / Supabase Postgres ───────────────────────────────────────────────

# Supavisor pooler URL (port 6543) — primary DB connection used by gbrain engine.
# Falls back to SUPABASE_DB_URL_POOLER if not set (lib/gbrain/engine.ts).
GBRAIN_DATABASE_URL=

# Direct connection URL (port 5432) — used for migrations, not pooled queries.
SUPABASE_DB_URL_DIRECT=

# Supavisor pooler URL (port 6543) — fallback if GBRAIN_DATABASE_URL is absent.
SUPABASE_DB_URL_POOLER=

# ─── Supabase project ─────────────────────────────────────────────────────────

# Supabase project URL (e.g. https://<ref>.supabase.co)
SUPABASE_URL=

# Service role key — bypasses RLS; never expose to the client bundle.
# Used server-side in lib/storage/ for Storage REST API calls.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Supabase Storage ─────────────────────────────────────────────────────────

# Storage backend selector. Set to "supabase" for production (lib/storage/index.ts).
STORAGE_BACKEND=supabase

# Supabase Storage bucket name (e.g. brain-files).
STORAGE_BUCKET=brain-files

# ─── LLM providers (required by gbrain, not by Next.js directly) ──────────────

# OpenAI API key — required by gbrain for text-embedding-3-small vector search.
# Without this, gbrain falls back to keyword-only search and most semantic
# questions ("what was weird about March?") return degraded answers.
OPENAI_API_KEY=

# Anthropic API key — required by gbrain for query expansion and think synthesis.
# Without this, gbrain skips query expansion and answer quality drops noticeably.
ANTHROPIC_API_KEY=

# ─── Sentry (observability — DEPLOY-04) ───────────────────────────────────────

# Sentry DSN — client-safe, NEXT_PUBLIC_ prefix is intentional.
# Obtained from: Sentry → Project Settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token — build-time source-map upload only. NEVER use NEXT_PUBLIC_.
# Obtained from: Sentry → Settings → Auth Tokens (project:releases scope).
# [build-time] — read by withSentryConfig during next build, not at runtime.
SENTRY_AUTH_TOKEN=

# Sentry organization slug (e.g. my-org).
SENTRY_ORG=

# Sentry project slug (e.g. quickbrain).
SENTRY_PROJECT=

# ─── Phase 6 preconditions (not yet required — listed for completeness) ────────

# Resend API key — required for transactional email (Phase 6 auth flow).
# Operator must obtain a verified Resend domain before Phase 6.
# RESEND_API_KEY=
